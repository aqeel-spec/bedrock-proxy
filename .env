# ============================================================================
# Claude-Bedrock Proxy Environment Configuration
# ============================================================================
# This proxy translates Claude Code (Anthropic Messages API) into any
# OpenAI-compatible endpoint. Set these variables to control behavior.
# ============================================================================

# ---- REQUIRED: Upstream Provider Configuration ----

# Base URL of your OpenAI-compatible provider
# Examples:
#   AWS Bedrock:  https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
#   Z.ai (GLM):   https://open.bigmodel.cn/api/paas/v4
#   OpenRouter:   https://openrouter.ai/api/v1
#   OpenAI:       https://api.openai.com/v1
#   Groq:         https://api.groq.com/openai/v1
#   DeepSeek:     https://api.deepseek.com/v1
OPENAI_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# API key for the upstream provider (bearer token)
OPENAI_API_KEY=

# ---- OPTIONAL: Model & Routing Configuration ----

# Fallback model if Claude Code doesn't send one
# Leave empty to force clients to always specify a model
# Examples: zai.glm-5, gpt-4-turbo, mixtral-8x7b-32768
DEFAULT_MODEL_ID=zai.glm-4.7

# Model aliases: short names → upstream model IDs (JSON object)
# Lets you use ANTHROPIC_MODEL=glm instead of ANTHROPIC_MODEL=zai.glm-5
# Model names not in this map pass through to upstream as-is
MODEL_MAP={"glm5":"zai.glm-5", "glm-4.7":"zai.glm-4.7","grok-4.3":"xai.grok-4.3","qwen3-next-coder":"qwen.qwen3-coder-next","deepseek-3.2":"deepseek.v3.2", "minimax-2.5" : "minimax.minimax-m2.5"}

# ---- OPTIONAL: Security ----

# RECOMMENDED: Shared secret that Claude Code sends as x-api-key header
# Prevents unauthorized access to your proxy (and API credits)
# Generate with: openssl rand -base64 32
# Example: PROXY_SECRET=iQWoW9E7p2L8kX5mN3jR6vT9sB4cF1dG7hJ2yK8pL5mQ=
PROXY_SECRET=

# ---- OPTIONAL: Monitoring & Debugging ----

# Enable detailed request logging (JSON output to Vercel logs)
# Set to 'true' to log all requests, responses, timings, and errors
# Useful for debugging but slightly increases costs
ENABLE_LOGGING=false

# ---- LEGACY: Bedrock-only mode (fallback if OPENAI_BASE_URL not set) ----
# These are only used if OPENAI_BASE_URL / OPENAI_API_KEY are NOT defined
# Prefer the OPENAI_* vars above, which work with Bedrock + everything else

# AWS region for Bedrock (e.g., us-east-1, eu-west-1)
AWS_REGION=us-east-1

# AWS Bedrock API key (only used if OPENAI_API_KEY not set)
AWS_BEDROCK_API_KEY=

# Bedrock model ID (only used if DEFAULT_MODEL_ID not set)
BEDROCK_MODEL_ID=zai.glm-4.7