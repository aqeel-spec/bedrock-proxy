# Copy this file to .env before starting the local server:
#   copy .env.example .env       (Windows)
#   cp .env.example .env         (macOS/Linux)
# Keep .env private. It is ignored by git.

# ---- Preferred: point at ANY OpenAI-compatible provider ----
# Base URL, no trailing slash, no "/chat/completions" (the proxy appends that).
# Examples:
#   https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1   (AWS Bedrock Mantle)
#   https://open.bigmodel.cn/api/paas/v4                        (Z.ai / GLM direct)
#   https://api.openai.com/v1                                   (OpenAI, incl. Codex-family models)
#   https://openrouter.ai/api/v1                                (OpenRouter — many models, one key)
OPENAI_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# Bearer token for whichever provider OPENAI_BASE_URL points at.
OPENAI_API_KEY=

# Fallback model if the client doesn't send one at all. Leave blank to force
# clients to always specify a model.
DEFAULT_MODEL_ID=zai.glm-4.7

# Optional: map short aliases to real upstream model ids, as a JSON object.
# Lets you set ANTHROPIC_MODEL=glm or ANTHROPIC_MODEL=codex on the client
# without remembering exact provider model strings. Any model name NOT in
# this map is passed straight through to the upstream as-is.
MODEL_MAP={"glm":"zai.glm-5","glm-flash":"zai.glm-4.7-flash","codex":"gpt-5-codex"}

# Optional but recommended, especially when binding a VPS to a public address.
# Claude Code sends this value as its x-api-key header.
PROXY_SECRET=

# Optional legacy Bedrock-only fallback. Only used if OPENAI_BASE_URL or
# OPENAI_API_KEY is not set.
AWS_REGION=us-east-1
AWS_BEDROCK_API_KEY=
BEDROCK_MODEL_ID=zai.glm-4.7
